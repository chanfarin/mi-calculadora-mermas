<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Planificador de Producción</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1>Planificar Pedido (Cálculo Inverso)</h1>
        <form action="/calcular" method="POST">
            <div class="form-group">
                <label for="producto">Nombre del Producto / Línea</label>
                <input type="text" id="producto" name="producto" placeholder="Ej. Filete de Salmón" required>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div class="form-group">
                    <label>Nº Bandejas Pedidas</label>
                    <input type="number" name="numeroBandejas" placeholder="100" required>
                </div>
                <div class="form-group">
                    <label>Kg por Bandeja</label>
                    <input type="number" step="0.001" name="kilosPorBandeja" placeholder="0.500" required>
                </div>
                <div class="form-group">
                    <label>Peso Estándar de Caja (Kg)</label>
                    <input type="number" step="0.01" name="pesoCajaStandard" placeholder="10.000" required>
                </div>
            </div>

            <h3>Porcentajes de Merma Estimados (%)</h3>
            
            <div class="form-group">
                <label>1. Merma por Corte / Fileteo (%)</label>
                <input type="number" step="0.1" name="mermaFileteo" placeholder="ej. 15" required>
            </div>

            <div class="form-group">
                <label>2. Merma por Embandejado (%)</label>
                <input type="number" step="0.1" name="mermaEmbandejado" placeholder="3" required>
            </div>

            <div class="form-group">
                <label>3. Desecho por Invalidez / Calidad (%)</label>
                <input type="number" step="0.1" name="mermaInvalidez" placeholder="2" required>
            </div>

            <button type="submit">Calcular Materia Prima Requerida</button>
        </form>

        <!-- Añade este enlace justo debajo del botón o en la cabecera de views/index.ejs -->
<div style="text-align: center; margin-top: 1.5rem;">
    <a href="/historial" class="btn-link">📋 Ver Historial Completo de Órdenes</a>
</div>

 </div>
</body>
</html>
